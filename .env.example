# 复制到 .env.local，或在 Vercel 项目环境变量中配置；不要提交真实密钥。
# 必填：在 Resend 验证发信域名后配置这三项。邮箱只填地址，不含显示名。
RESEND_API_KEY=
RFQ_FROM_EMAIL=
RFQ_TO_EMAIL=

# 正式联系邮箱用于页脚、无脚本兜底和提交失败的 mailto 联系入口。
NEXT_PUBLIC_CONTACT_EMAIL=
# 国际号码只填数字；留空时不显示 WhatsApp 挂件。
NEXT_PUBLIC_WHATSAPP_NUMBER=
# 正式运营主体；留空时明确标为待确认。
NEXT_PUBLIC_LEGAL_NAME=
# 根域 / www 方案待确认；此变量只控制 canonical，不修改 DNS 或重定向。
NEXT_PUBLIC_SITE_URL=https://glinticstudio.com
